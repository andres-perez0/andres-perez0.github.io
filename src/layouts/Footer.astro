---
import {Icon} from 'astro-icon/components';

const {currentYear} = Astro.props;
const icon_height=30;
---

<footer>
    <div id="trademark">
        made with astro and tailwindCSS. check out the <a id="github-repo" href="https://github.com/andres-perez0/andres-perez0.github.io">github</a> here. @Andres Perez 2024-{currentYear}
    </div>
    <!-- Social Links -->
    <nav id="social-link" class="icons flex items-center">
        <a href="https://github.com/andres-perez0/"               ><Icon name="mdi:github"    size={icon_height}></Icon></a>
        <a href="https://www.linkedin.com/in/andres-perez0/"      ><Icon name="mdi:linkedin"  size={icon_height}></Icon></a>
        <a href="https://www.instagram.com/chitoperez1990/"       ><Icon name="mdi:instagram" size={icon_height}></Icon></a>
        <a href="https://discordapp.com/users/659599215101476874" ><Icon name="mdi:discord"   size={icon_height}></Icon></a>
        <a href="mailto:aperez26@nd.edu" ><Icon name="mdi:email"   size={icon_height}></Icon></a>
    </nav>
</footer>