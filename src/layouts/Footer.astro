---
import {Icon} from 'astro-icon/components';

const {currentYear} = Astro.props;
const icon_height   =30;
const website_link  ="https://github.com/andres-perez0/andres-perez0.github.io";
const github_link   ="https://github.com/andres-perez0/";
const linkedin_link ="https://www.linkedin.com/in/andres-perez0/";
const mail_to       ="mailto:aperez26@nd.edu";
---

<footer>
    <div id="trademark">
        Made with Astro and TailwindCSS. 
        Check out the <a id="github-repo" href={website_link}>github</a> here.
        @Andres Perez 2024-{currentYear}
    </div>
    <!-- Social Links -->
    <nav id="social-link" class="icons flex items-center">
        <a href={github_link}        ><Icon name="mdi:github"    size={icon_height}></Icon></a>
        <a href={linkedin_link}      ><Icon name="mdi:linkedin"  size={icon_height}></Icon></a>
        <a href={mail_to}            ><Icon name="mdi:email"     size={icon_height}></Icon></a>
    </nav>
</footer>