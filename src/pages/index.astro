---
// Components Imports
import Layout from "../layouts/Layout.astro"
import CourseworkSection from "../components/CourseworkSection.astro"
import { coursework } from "../data/coursework"
---
<Layout title="Home - Andres Perez">
    <div slot="main" id="frame-div">
        <div id="main-div" class="m-0 p-0">
            <div id="textblock-div">
                <h1 id="header-tag">Hey Everyone! 👋</h1>
                <p>
                    I am Andres and I'm a computer engineering student at the University of Notre Dame focused on hardware-software co-design (FPGA, ASIC, & Low-Level System design). Born and raised in Long Beach, California, I am the proud son of factory workers from Mexico, forging my path as a first-generation college student. 
                </p>
                <p>
                    I recently interned at NVIDIA as a Hardware Ignite Intern apart of the GPU Infrastructure team, where I worked on tooling for continuous integration systems. I'm excited to return this Summer 2027! And This semester you can find me: 
                </p>
                <div class="flex flex-col md:flex-row items-center md:items-start gap-6 mb-4">
                    <div class="flex-1">
                        <ul class="indent-4 list-disc list-inside my-2">
                            <li>
                                Modernizing IrishSat Ground Station Antenna & maintaining our Helmholtz
                                cage project as Electronics Lead for GOAT Lab. 
                            </li>
                            <li>
                                Implementing an AXI4-Stream Switch into an High Speed Data 
                                acquisition system for the Radio Hound Research Project.
                            </li>
                            <li>
                                Authoring the CREATE Newsletter for the Center for Career Development 
                                (If you're an ND Alumni and want to be feature, feel free to reach out!)
                            </li>
                        </ul>
                    </div>
                    <div class="w-full md:w-1/3 lg:w-1/4">
                        <img 
                            id="main-image" 
                            src="/brand/aperez26_headshot.jpg" 
                            alt="Andres Perez Headshot" 
                            class="rounded-lg shadow-lg w-full h-auto object-cover"
                            loading="lazy"
                        >
                    </div>
                </div> 
                <p> 
                    Beyond the classroom, I enjoy calisthenics, chess, and learning Spanish & Japanese. I love talking about musicals, space, and the developments in AI! So feel free to reach out! 
                </p>
            </div>

            <CourseworkSection semesters={coursework} showMinors={false} />
        </div>
    </div>
</Layout>