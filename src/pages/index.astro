---
// Components Imports
import Layout from "../layouts/Layout.astro"
---
<Layout title="Home - Andres Perez">
    <div slot="main" id="frame-div">
        <div id="main-div" class="m-0 p-0">
            <div id="textblock-div">
                <h1 id="header-tag">Hello, Welcome 👋</h1>
                <div class="flex flex-row items-center">
                    <div>
                        <p>I'm Andres Perez, an undergraduate at the University of Notre Dame studying Computer Engineering with a minor in Engineering Corporate Practice. My interests lie in embedded systems, robotics, and semiconductors.</p>
                        <ul class="indent-4 list-disc list-inside my-2">Currently, I'm:
                            <li>aiming to join an electrical engineering / low-level systems research lab this semester</li>
                            <li>committing my time to IrishSat as the new Electronics Lead for the GOAT subteam, where I'm leading development on our Helmholtz cage project</li>
                            <li>diving into hands-on work that blends circuit design, embedded software, and systems engineering</li>
                            <li>on the lookout for an internship for Summer 2026</li>
                        </ul>
                    </div>
                    <img id="main-image" src="/brand/PFP.jpg" alt="Placeholder image until I get a professional one." class="rounded-lg shadow-lg w-64 h-64 object-cover shrink-0">
                </div> 
                <p>In my free time, I lift weights, play chess + billiards, and chip away at learning Japanese. I'm also always down to talk robotics, system design, or your favorite anime.</p>
            </div>

            <div id="textblock-div">
                <h1 id="header-tag">Coursework 📚</h1>
                <hr class="border-zinc-400 my-4" />

                <h2 class="text-left text-lg">Fall 2025 (Projected)</h2>
                <ul class="indent-2 list-disc list-inside mb-4">
                    <li>CSE 20110 - Discrete Mathematics</li>
                    <li>CSE 20312 - Data Structures</li>
                    <li>EE 20100 - Introduction to ECE</li>
                    <li>Math 20580 - Linear Algebra & Differential Equations</li>
                    <li>Phys 10320 - Engineering Physics II: Electromagnetism</li>
                </ul>

                <h2 class="text-left text-lg">Summer 2025</h2>
                <ul class="indent-2 list-disc list-inside mb-4">
                    <li>EG 44421 - Integrated Engineering and Business Fundamentals</li>
                    <li>EG 34001 - Exploring Engineering Feats of London</li>
                </ul>

                <h2 class="text-left text-lg">Spring 2025</h2>
                <ul class="indent-2 list-disc list-inside mb-4">
                    <li>CSE 20311 - Fundamentals of Computing</li>
                    <li>EE 10200 - Introduction to Embedded Systems</li>
                    <li>FYS 10102 - Moreau First Year Experience</li>
                    <li>Math 10560 - Calculus II</li>
                    <li>Phys 10310 - Engineering: Phys I: Mechanics</li>
                    <li>RU 13186 - Usem Literature: The Anti-Empire Empire: Russia, Center, and Periphery</li>
                </ul>
                
                <h2 class="text-left text-lg">Fall 2024</h2>
                <ul class="indent-2 list-disc list-inside">
                    <li>CHEN 10171 - Introduction to Chemical Principles</li>
                    <li>ECON 10010 - Principles of Microeconomics</li>
                    <li>EG 10117 - Engineering Design</li>
                    <li>FYS 10101 - Moreau First Year Experience</li>
                    <li>Math 10550 - Calculus I</li>
                    <li>THEO 10001 - Foundations of Theology: Biblical/Historical</li>
                </ul>
            </div>
        </div>
    </div>
</Layout>

<style>
    p {
        text-indent: 2rem;
        overflow-wrap: break-word;
        margin: 0.25rem 0;
    }
</style>