---
// Components Imports
import Layout from "../layouts/Layout.astro"
---
<Layout title="Home - Andres Perez">
    <div slot="main" id="frame-div">
        <div id="main-div" class="m-0 p-0">
            <div id="textblock-div">
                <h1 id="header-tag">Welcome! 👋</h1>
                <p> I'm Andres Perez, an first generation Mexican-American student at the University of Notre Dame studying Computer 
                    Engineering with a minor in Engineering Corporate Practice. My interests lie in 
                    embedded systems, robotics, and learning everything low-level! Currently, I'm:</p>
                <div class="flex flex-col md:flex-row items-center md:items-start box-border">
                    <div>
                        <ul class="indent-4 list-disc list-inside my-2">
                            <li>Committing my time to IrishSat as the new Electronics Lead for the GOAT 
                                subteam, where I'm leading development on our Helmholtz cage project</li>
                            <li>Authoring the CREATE Newsletter for the Center for Career Development 
                                (If you're an ND Alumni and want to be feature, feel free to reach out!)</li>
                            <li>On the lookout for an internship for Summer 2026!</li>
                        </ul>
                    </div>
                    <img id="main-image" src="/brand/headshot.jpg" alt="Photo by William Mendler" class="rounded-lg shadow-lg ml-1 w-3/4 object-contain">
                </div> 
                <p> In my free time, I enjoy calisthenics, playing chess and billiards, and making steady progress in learning Japanese. 
                    I'm also always up for a conversation about your favorite musical, the latest in robotics and AI, or space.</p>
            </div>

            <div id="textblock-div">
                <h1 id="header-tag">Coursework 📚</h1>
                <hr class="border-zinc-400 my-4" />

                <h2 class="text-left text-lg">Fall 2025 (18 Credits)</h2>
                <ul class="indent-2 list-disc list-inside mb-4">
                    <li>CSE 20110 - Discrete Mathematics</li>
                    <li>CSE 20312 - Data Structures</li>
                    <li>EE 20100 - Introduction to ECE</li>
                    <li>EE 28499 - Undergraduate Research</li>
                    <li>Math 20580 - Linear Algebra & Differential Equations</li>
                    <li>Phys 10320 - Engineering Physics II: Electromagnetism</li>
                </ul>

                <h2 class="text-left text-lg">Summer 2025 (6 Credits)</h2>
                <ul class="indent-2 list-disc list-inside mb-4">
                    <li id="ECP-class">*EG 44421 - Integrated Engineering and Business Fundamentals</li>
                    <li>EG 34001 - Exploring Engineering Feats of London</li>
                </ul>

                <h2 class="text-left text-lg">Spring 2025 (19 Credits)</h2>
                <ul class="indent-2 list-disc list-inside mb-4">
                    <li>CSE 20311 - Fundamentals of Computing</li>
                    <li>EE 10200 - Introduction to Embedded Systems</li>
                    <li>FYS 10102 - Moreau First Year Experience</li>
                    <li>Math 10560 - Calculus II</li>
                    <li>Phys 10310 - Engineering: Phys I: Mechanics</li>
                    <li>RU 13186 - Usem Literature: The Anti-Empire Empire: Russia, Center, and Periphery</li>
                </ul>
                
                <h2 class="text-left text-lg">Fall 2024 (18 Credits)</h2>
                <ul class="indent-2 list-disc list-inside">
                    <li>CHEN 10171 - Introduction to Chemical Principles</li>
                    <li id="ECP-class">*ECON 10010 - Principles of Microeconomics</li>
                    <li>EG 10117 - Engineering Design</li>
                    <li>FYS 10101 - Moreau First Year Experience</li>
                    <li>Math 10550 - Calculus I</li>
                    <li>THEO 10001 - Foundations of Theology: Biblical/Historical</li>
                </ul>
                <p id="ECP-class">*Engineering Cooperate Practice Class (2/5)</p>
            </div>
        </div>
    </div>
</Layout>