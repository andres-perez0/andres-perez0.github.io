---
// Components Imports
import Layout from "../layouts/Layout.astro"
import {Icon} from 'astro-icon/components';
const icon_height=30;

--- 

<Layout title="Contact - Andres Perez" description="Email me @ aperez26@nd.edu">
    <body>
        <div slot="main" id="frame-div"> 
            <div id="main-div" class="m-0 p-0">
                <div id="textblock-div">
                    <h1 id="header-tag" class="text-center">Contact ✉️</h1>
                    <hr class="border-zinc-400 my-4" />
                    <p>The best way to reach me would be via email. I am also active on Linkedin as well.</p>
                    <nav id="social-link" class="icons indent-2 list-disc list-inside">
                        <a href="mailto:aperez26@nd.edu"                          ><Icon name="mdi:email"     size={icon_height}></Icon>Email</a>
                        <a href="https://www.linkedin.com/in/andres-perez0/"      ><Icon name="mdi:linkedin"  size={icon_height}></Icon>Linkedin</a>
                        <a href="https://github.com/andres-perez0/"               ><Icon name="mdi:github"    size={icon_height}></Icon>Github</a>
                    </nav>
                </div>
            </div> 
        </div>
    </body>
</Layout>
